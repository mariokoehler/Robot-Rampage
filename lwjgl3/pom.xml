<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.mkoehler.robotrampage</groupId>
    <artifactId>robotrampage-parent</artifactId>
    <version>0</version>
  </parent>

  <artifactId>robotrampage-lwjgl3</artifactId>
  <packaging>jar</packaging>
  <name>RobotRampage-lwjgl3</name>

  <properties>
    <mainClass>de.mkoehler.robotrampage.lwjgl3.Lwjgl3Launcher</mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.mkoehler.robotrampage</groupId>
      <artifactId>robotrampage-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-backend-lwjgl3</artifactId>
      <version>${gdxVersion}</version>
    </dependency>
    <dependency>
      <!-- Every native-backed libGDX piece needs its own *-platform natives-desktop dependency
           (see CLAUDE.md "Maven + libGDX gotchas"): core libGDX here, FreeType just below. -->
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-platform</artifactId>
      <version>${gdxVersion}</version>
      <classifier>natives-desktop</classifier>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-freetype-platform</artifactId>
      <version>${gdxVersion}</version>
      <classifier>natives-desktop</classifier>
    </dependency>
    <!-- Test-scoped so it never ends up in the shaded runtime jar: used by the AtlasPacker dev tool
         under src/test, run on demand to rebuild assets/textures/game.atlas from the PNGs already in
         assets/ (deliberately not assets-raw/, unlike the StarWars project — see AtlasPacker's Javadoc). -->
    <dependency>
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-tools</artifactId>
      <version>${gdxVersion}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${appName}-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The assets/ folder at the repo root is bundled onto the classpath. -->
      <resource>
        <directory>${project.basedir}/../assets</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- Run with: mvn -pl lwjgl3 compile exec:exec (core must already be installed
             locally, see CLAUDE.md "Build system" - do NOT add -am here: a bare goal invoked
             with -am runs across the WHOLE reactor, including the parent aggregator pom, which
             has no config for this plugin and fails immediately). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>java</executable>
          <workingDirectory>${project.basedir}/../assets</workingDirectory>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>${mainClass}</argument>
          </arguments>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${mainClass}</mainClass>
                  <manifestEntries>
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Builds the packaged Windows client zip (design.md 3.11): a jpackage app-image
         (native RobotRampage.exe + a trimmed jlink runtime, no JDK/JRE install required by
         players) plus update.cmd, zipped as RobotRampage-Client.zip. Not run on an ordinary
         `mvn clean package` - deliberately opt-in via `mvn -pl lwjgl3 -am -Prelease-client
         verify`, so everyday dev builds stay exactly as fast as they are today. Migrated
         verbatim from the StarWars project's identical profile - see its CLAUDE.md/design.md
         3.11 for the gotchas this was built against (the four-phase plugin spread below, the
         duplicate-plugin-declaration trap, jpackage's own version-string restriction). -->
    <profile>
      <id>release-client</id>
      <properties>
        <!-- jpackage's appVersion parameter rejects jgitver's "-SNAPSHOT"-qualified versions
             (only plain major[.minor[.build]] is accepted) - this is purely cosmetic
             (Explorer file properties, Add/Remove Programs), never the compatibility-check
             version. AppVersion.getVersion() (core/.../net/) keeps reading the full,
             untouched ${project.version} from robotrampage-version.properties for that. -->
        <jpackage.appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</jpackage.appVersion>
        <jpackage.inputDir>${project.build.directory}/jpackage-input</jpackage.inputDir>
        <jpackage.outputDir>${project.build.directory}/jpackage</jpackage.outputDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>parse-version-for-jpackage</id>
                <phase>validate</phase>
                <goals>
                  <goal>parse-version</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <!-- Four steps, each bound to its own distinct standard-lifecycle phase between
               `package` (the shade plugin, above) and `verify` - NOT four executions crammed
               into one shared phase relying on plugin-declaration order, which turned out to
               be unsafe in the StarWars project this was migrated from: jpackage refuses to
               run if its destination app folder already exists, and a same-phase copy-
               resources execution declared earlier creates exactly that folder as a side
               effect of copying into it. Spreading them across pre-integration-test ->
               integration-test -> post-integration-test -> verify sidesteps the whole
               question. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>stage-jpackage-input</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <!-- A clean, jar-only directory for jpackage to read - target/ itself also
                       holds classes/, test-classes/, the pre-shade original-*.jar etc., none
                       of which belong in a player's zip. -->
                  <outputDirectory>${jpackage.inputDir}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.directory}</directory>
                      <includes>
                        <include>${appName}-${project.version}.jar</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <!-- Second execution of this same plugin (kept in this one block, not a
                   separate <plugin> element - Maven flags/collapses duplicate groupId:
                   artifactId plugin declarations within one <plugins> list and only one
                   of them actually ran, silently dropping the other's executions - the
                   StarWars project this was migrated from hit exactly this). Runs after
                   jpackage (integration-test, below) has already created its destination
                   folder. -->
              <execution>
                <id>copy-update-cmd</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <!-- jpackage's app-image output directory for type=APP_IMAGE, name=${appName}
                       is <destination>/${appName}/ - update.cmd lands next to the generated exe. -->
                  <outputDirectory>${jpackage.outputDir}/${appName}</outputDirectory>
                  <resources>
                    <resource>
                      <directory>src/main/dist</directory>
                      <includes>
                        <include>update.cmd</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.6.6</version>
            <executions>
              <execution>
                <phase>integration-test</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <name>${appName}</name>
              <appVersion>${jpackage.appVersion}</appVersion>
              <vendor>Mario Koehler</vendor>
              <input>${jpackage.inputDir}</input>
              <mainJar>${appName}-${project.version}.jar</mainJar>
              <mainClass>${mainClass}</mainClass>
              <type>APP_IMAGE</type>
              <destination>${jpackage.outputDir}</destination>
              <!-- Lives in assets-raw/, alongside this project's other pre-processed source art
                   (design.md's assets-raw/ -> assets/ convention) - jpackage only needs a
                   build-time file path for this, it never ends up on the classpath, so no
                   copy into assets/ is needed. -->
              <icon>${project.basedir}/../assets-raw/icon.ico</icon>
              <!-- jpackage's own resource-dir override mechanism: a file named
                   <launcher-name>.manifest here (RobotRampage.manifest, matching <name> above)
                   replaces jpackage's default embedded Windows application manifest for the
                   generated exe - see that file's own comment for why (DPI-unaware, so Windows
                   scales the whole rendered window to match the monitor's real DPI instead of
                   leaving that to this app). -->
              <resourceDir>${project.basedir}/src/main/jpackage-resources</resourceDir>
              <javaOptions>
                <option>--enable-native-access=ALL-UNNAMED</option>
              </javaOptions>
              <!-- Escape hatch for jlink/jdeps under-detecting modules needed by reflection-heavy
                   dependencies (Kryo, Jackson) - leave unset unless a packaged build actually
                   fails at runtime with a missing-module error, then try e.g.
                   `mvn ... -Prelease-client -Djpackage.addModules=ALL-MODULE-PATH verify`. -->
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.8.0</version>
            <executions>
              <execution>
                <id>zip-client</id>
                <phase>verify</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <descriptors>
                    <descriptor>src/main/assembly/client-zip.xml</descriptor>
                  </descriptors>
                  <finalName>RobotRampage-Client</finalName>
                  <appendAssemblyId>false</appendAssemblyId>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
